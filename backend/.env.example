# VISTASpace backend configuration. Copy to .env and edit. No secrets are required.

# HTTP / WebSocket server
VISTA_HOST=127.0.0.1
VISTA_PORT=8000
# Comma-separated origins allowed to call the API (the Vite dev server by default)
VISTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# SQLite database for telemetry history and the mission log
VISTA_DB_PATH=data/vistaspace.db

# A source counts as live only if it sent a reading within this many seconds
VISTA_STALE_SECONDS=5

# --- Serial sensor (Arduino / ESP32 / Raspberry Pi Pico over USB) ---
# Leave empty to disable. Examples: /dev/ttyUSB0, /dev/ttyACM0, COM3
VISTA_SERIAL_PORT=
VISTA_SERIAL_BAUD=115200

# --- MQTT sensor ---
# Leave host empty to disable.
VISTA_MQTT_HOST=
VISTA_MQTT_PORT=1883
VISTA_MQTT_TOPIC=vistaspace/telemetry/#
VISTA_MQTT_USERNAME=
VISTA_MQTT_PASSWORD=

# --- HTTP sensors ---
# Devices POST JSON to /api/telemetry. Set a shared token to require "Authorization: Bearer <token>".
VISTA_INGEST_TOKEN=

# --- Simulation fallback ---
# When true, the backend emits clearly labelled SIMULATED readings while no live source is reporting.
VISTA_SIM_FALLBACK=false
VISTA_SIM_INTERVAL=1.0

# --- Object detection ---
# "yolo" loads ultralytics YOLOv8 if installed (pip install -r requirements-yolo.txt); "none" disables it.
VISTA_DETECTOR=yolo
VISTA_YOLO_MODEL=yolov8n.pt
VISTA_YOLO_CONF=0.35
